{
  "expo": {
    "name": "Pareja",
    "slug": "pareja-app",
    "owner": "kaelfernandez",
    "version": "1.0.0",
    "scheme": "pareja",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kaelfernandez.pareja"
    },
    "android": {
      "package": "com.kaelfernandez.pareja",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FCEEE9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pareja necesita acceso a tus fotos para que puedas compartirlas con tu pareja.",
          "cameraPermission": "Pareja necesita acceso a la cámara para que puedas tomar fotos y compartirlas."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Pareja usa tu calendario para guardar los planes que compartes con tu pareja."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pareja usa tu ubicación para marcar los lugares que visitan juntos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#D0668A",
          "defaultChannel": "default"
        }
      ],
      "expo-dev-client",
      [
        "./plugins/with-widget-resize",
        {
          "widgets": {
            "LatestPhoto": {
              "minResizeWidth": "90dp",
              "minResizeHeight": "90dp"
            },
            "DaysTogether": {
              "minResizeWidth": "90dp",
              "minResizeHeight": "90dp"
            },
            "NextDate": {
              "minResizeWidth": "160dp",
              "minResizeHeight": "30dp"
            },
            "UpcomingPlans": {
              "minResizeWidth": "160dp",
              "minResizeHeight": "100dp"
            }
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/nunito/600SemiBold/Nunito_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf",
            "./node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf"
          ],
          "widgets": [
            {
              "name": "LatestPhoto",
              "label": "Última foto",
              "description": "La última foto que compartieron.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/widget-latest-photo.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "DaysTogether",
              "label": "Días juntos",
              "description": "Los días que llevan juntos.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/widget-days-together.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NextDate",
              "label": "Próxima fecha",
              "description": "Su próxima fecha importante y cuánto falta.",
              "minWidth": "180dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/widget-next-date.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "UpcomingPlans",
              "label": "Próximos planes",
              "description": "Sus próximos planes y fechas importantes.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/widget-upcoming-plans.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFAF7"
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7504b320-00a6-4f98-9577-c2b1be6de840"
      }
    }
  }
}
